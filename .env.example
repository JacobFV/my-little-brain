OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
PORT=4318
HOST=127.0.0.1
# For LAN/remote access set HOST=0.0.0.0, a strong APP_ACCESS_TOKEN, and origins.
APP_ACCESS_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Google Drive browser OAuth. Token connections need none of these.
# Register this exact web-app URI in the Google Cloud OAuth client first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/?account_oauth=google

# Optional Notion public-integration browser OAuth. Register this exact callback.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://127.0.0.1:5173/?account_oauth=notion
