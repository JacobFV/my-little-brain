{
  "name": "@little-brain/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform ios --platform android",
    "export": "expo export --platform ios --platform android",
    "typecheck": "tsc --noEmit",
    "build:android": "npx eas-cli build --platform android",
    "build:ios": "npx eas-cli build --platform ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.21",
    "expo-sharing": "~14.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
